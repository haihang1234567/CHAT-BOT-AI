# Máy chủ local
PORT=3100
SHOP_DOMAIN=https://www.greenholdingsport.vn
PRODUCT_CSV_PATH=./data/products.csv
STORE_PATH=./data/local-store.json
ADMIN_PASSWORD=123456

# API AI
ANTHROPIC_BASE_URL=https://llm.wokshop.com
ANTHROPIC_AUTH_TOKEN=sk-7bpmSqsYcllJggA0YBetk7IPVBt574QgsCgiLT0M2g7sj9Vt

# Có thể dùng 1 model chung cho cả 2 lần gọi AI
AI_MODEL= claude-haiku-4-5

# Hoặc tách riêng model nhẹ cho Router và model tốt hơn cho trả lời cuối.
# Nếu để trống, hệ thống tự dùng AI_MODEL.
AI_ROUTER_MODEL=
AI_CHAT_MODEL=

# Cấu hình API. Mặc định phù hợp API kiểu Anthropic Messages.
AI_API_STYLE=anthropic
AI_MESSAGES_PATH=/v1/messages
AI_AUTH_MODE=bearer
ANTHROPIC_VERSION=2023-06-01
AI_TIMEOUT_MS=45000

# AI lần 1: nhận dạng ý định và tạo bộ lọc JSON.
AI_ROUTER_MAX_TOKENS=240
AI_ROUTER_HISTORY_MESSAGES=3
AI_ROUTER_HISTORY_CHARS=220

# AI lần 2: nhận kết quả database đã lọc và trả lời khách.
AI_FINAL_MAX_TOKENS=520
AI_MAX_CANDIDATES=5
AI_MAX_VARIANTS=10
AI_DESCRIPTION_CHARS=650
AI_HISTORY_MESSAGES=4
AI_HISTORY_CHARS=350

# true = mọi tin nhắn bot hợp lệ đều dùng AI lần 2 sau Router.
# Lệnh admin trực tiếp và cuộc chat đang do nhân viên xử lý vẫn không gọi AI.
AI_ALWAYS_FINAL=true

# Cache trong RAM để câu hỏi lặp lại không gọi API lần nữa.
AI_CACHE_TTL_MS=1800000
