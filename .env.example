# Cổng và dữ liệu local
PORT=3100
SHOP_DOMAIN=https://www.greenholdingsport.vn
PRODUCT_CSV_PATH=./data/products.csv
STORE_PATH=./data/local-store.json

# Đổi mật khẩu này trước khi cho thiết bị khác truy cập
ADMIN_PASSWORD=change-me-before-deploy

# Nguồn sản phẩm: haravan hoặc csv
PRODUCT_SOURCE=haravan
HARAVAN_API_BASE_URL=https://apis.haravan.com/com
HARAVAN_ACCESS_TOKEN=
HARAVAN_PAGE_SIZE=50
HARAVAN_SYNC_INTERVAL_MS=600000
HARAVAN_TIMEOUT_MS=30000
HARAVAN_USE_LOCATION_INVENTORY=true
HARAVAN_LOCATION_IDS=
HARAVAN_INCLUDE_UNPUBLISHED=false
HARAVAN_FALLBACK_TO_CSV=true

# Tìm sản phẩm theo ngữ nghĩa bằng Voyage AI
# Tạo API key tại https://dash.voyageai.com/
VOYAGE_EMBEDDING_ENABLED=true
VOYAGE_API_KEY=
VOYAGE_API_URL=https://api.voyageai.com/v1/embeddings
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_OUTPUT_DIMENSION=512
VOYAGE_BATCH_SIZE=64
VOYAGE_TIMEOUT_MS=30000
VOYAGE_QUERY_CACHE_TTL_MS=1800000
VOYAGE_MIN_SCORE=0.25
VOYAGE_AUTO_SYNC=true
PRODUCT_EMBEDDINGS_PATH=./data/embeddings.json

# Kết nối API AI
ANTHROPIC_BASE_URL=https://llm.wokushop.com
ANTHROPIC_AUTH_TOKEN=
AI_MODEL=
AI_ROUTER_MODEL=
AI_CHAT_MODEL=

# Chuẩn API: anthropic hoặc openai
AI_API_STYLE=anthropic
AI_MESSAGES_PATH=/v1/messages
AI_AUTH_MODE=bearer
ANTHROPIC_VERSION=2023-06-01

# Giới hạn và hiệu năng AI
AI_COST_MODE=balanced
AI_ROUTER_MAX_TOKENS=500
AI_FINAL_MAX_TOKENS=320
AI_TIMEOUT_MS=45000
AI_MAX_CANDIDATES=3
CHAT_PRODUCT_PAGE_SIZE=3
AI_MAX_VARIANTS=4
AI_DESCRIPTION_CHARS=260
AI_HISTORY_MESSAGES=2
AI_HISTORY_CHARS=220
AI_ROUTER_HISTORY_MESSAGES=2
AI_ROUTER_HISTORY_CHARS=180
AI_CACHE_TTL_MS=1800000
AI_ALWAYS_FINAL=true
AI_ROUTER_ALWAYS=true
AI_PRODUCT_FINAL_ENABLED=false

# Tra cứu kiến thức có nguồn chính thống
# Ưu tiên kho kiến thức nội bộ trước để giảm chi phí Tavily
KNOWLEDGE_LOCAL_ENABLED=true
KNOWLEDGE_LOCAL_DIR=./knowledge
KNOWLEDGE_LOCAL_MAX_RESULTS=3
KNOWLEDGE_LOCAL_MIN_SCORE=2
KNOWLEDGE_LOCAL_SUFFICIENT_SCORE=8

# Chỉ gọi web khi kho nội bộ chưa có câu trả lời đủ phù hợp
# Tạo key miễn phí tại https://app.tavily.com
KNOWLEDGE_WEB_ENABLED=true
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
KNOWLEDGE_WEB_MAX_RESULTS=3
KNOWLEDGE_WEB_CONTENT_CHARS=550
KNOWLEDGE_WEB_TIMEOUT_MS=15000
KNOWLEDGE_WEB_CACHE_TTL_MS=86400000
# Có thể bổ sung website liên đoàn/nhà sản xuất chính thức, phân cách bằng dấu phẩy
KNOWLEDGE_OFFICIAL_DOMAINS=fifa.com,theifab.com,bwfbadminton.com,fivb.com,worldathletics.org,fiba.basketball,itftennis.com,ittf.com,usapickleball.org,olympics.com,mizuno.com,mizunousa.com,asics.com,nike.com,adidas.com,joma-sport.com
